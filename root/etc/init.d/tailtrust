#!/bin/sh /etc/rc.common
# These variables are consumed by rc.common.
# shellcheck disable=SC2034
START=97
# shellcheck disable=SC2034
USE_PROCD=1

start_service() {
    /usr/libexec/tailtrust-apply
}

reload_service() {
    /usr/libexec/tailtrust-apply
}

service_triggers() {
    procd_add_reload_trigger tailtrust
}
